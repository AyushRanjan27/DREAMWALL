# ==========================================
# DreamWall Frontend Environment Variables
# ==========================================

# URL of your backend deployed on Render (NO trailing slash)
# In production on Vercel: set this in Vercel Project Settings > Environment Variables
# Example: https://dreamwall-backend.onrender.com
# In local development: leave empty to automatically fallback to http://localhost:5000
REACT_APP_API_URL=https://your-backend-service.onrender.com
