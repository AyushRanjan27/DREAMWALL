{
  "name": "prompt-wallpaper-creation",
  "version": "1.0.0",
  "description": "A MERN stack website for generating wallpapers from user prompts",
  "scripts": {
    "start": "concurrently \"npm run server\" \"npm run client\"",
    "server": "cd server && npm start",
    "client": "cd client && npm start",
    "install-server": "cd server && npm install",
    "install-client": "cd client && npm install"
  },
  "devDependencies": {
    "concurrently": "^8.2.0"
  },
  "dependencies": {
    "axios": "^1.16.1",
    "openai": "^6.38.0"
  }
}
