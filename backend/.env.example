# ==========================================
# DreamWall Backend Environment Variables
# ==========================================

# Server Port (Render sets PORT automatically, use 5000 for local development)
PORT=5000

# MongoDB Connection String (Atlas URI for production, localhost for local dev)
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/wallpaperdb?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/wallpaperdb

# JWT Secret for user session tokens (Use a strong random string in production)
JWT_SECRET=your_jwt_secret_key_change_this_in_production

# Frontend Client URL (Your deployed Vercel domain)
# Example: https://dreamwall.vercel.app
CLIENT_URL=http://localhost:3000

# Optional: OpenAI API Key (Required ONLY if selecting DALL-E 3 engine)
OPENAI_API_KEY=sk-...

# Optional: Hugging Face Token (Required ONLY if selecting HuggingFace engine)
HF_TOKEN=hf_...
